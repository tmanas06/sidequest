# Supabase — get from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose to client

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# Ingestion (optional — controls fetch rate)
INGESTION_FETCH_INTERVAL_MS=300000       # 5 minutes between source refreshes
INGESTION_MAX_EVENTS_PER_SOURCE=200      # Limit per ingestion run
INGESTION_USER_AGENT=SideQuest-Bot/1.0 (https://sidequest.app; contact@sidequest.app)

# Cron secret — protect the ingestion endpoint
CRON_SECRET=your-long-random-secret-here
